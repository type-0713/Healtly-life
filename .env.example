# MedElite Environment Variables
# -------------------------------------------
# LOCAL DEV uchun: .env.local fayl yarating va quyidagilarni kiriting:
#   VITE_GROQ_API_KEY=gsk_YOUR_KEY_HERE
#
# VERCEL DEPLOY uchun:
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
#   Quyidagi o'zgaruvchini qo'shing (server-side, VITE_ prefikssiz):
#   GROQ_API_KEY=gsk_YOUR_KEY_HERE
#
# Groq API kalitini bu yerdan tekin oling:
#   https://console.groq.com/keys
# -------------------------------------------

# Local dev uchun (src kodi tomonidan to'g'ridan-to'g'ri ishlatiladi)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Vercel serverless function uchun (api/chat.ts tomonidan ishlatiladi)
GROQ_API_KEY=your_groq_api_key_here