# MedElite Environment Variables
# ─────────────────────────────────────────────────────────
# LOCAL DEV uchun:
#   1. .env.local fayl yarating (bu fayl gitga yuklanmaydi)
#   2. Ichiga yozing: GROQ_API_KEY=gsk_YOUR_KEY
#   3. Ixtiyoriy: GROQ_CHAT_MODEL=openai/gpt-oss-20b
#   4. npm run dev bilan AI'ni local tekshiring.
#
# VERCEL DEPLOY uchun:
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
#   GROQ_API_KEY = gsk_YOUR_KEY    (server-side, /api/chat uchun)
#   GROQ_CHAT_MODEL = openai/gpt-oss-20b  (ixtiyoriy model override)
#
# Bepul Groq API kaliti: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────

GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b
