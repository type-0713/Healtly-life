# MedElite Environment Variables
# ─────────────────────────────────────────────────────────
# LOCAL DEV uchun:
#   1. .env.local fayl yarating (bu fayl gitga yuklanmaydi)
#   2. Ichiga yozing: VITE_GROQ_API_KEY=gsk_YOUR_KEY
#
# VERCEL DEPLOY uchun:
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
#   GROQ_API_KEY = gsk_YOUR_KEY    (server-side, /api/chat uchun)
#   VITE_GROQ_API_KEY = gsk_YOUR_KEY  (build-time, frontend uchun)
#
# Bepul Groq API kaliti: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────

VITE_GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here